          "x": 0.07,
          "y": 0.48,
          "w": 0.86,
          "h": 0.24,
          "items": [
            {
              "value": "$51K-$68K",
              "caption": "Annual cost of the current workflow"
            },
            {
              "value": "$31K-$48K",
              "caption": "Estimated annual savings"
            },
            {
              "value": "155%-240%",
              "caption": "Estimated year 1 ROI"
            },
            {
              "value": "3-5 months",
              "caption": "Estimated payback period"
            }
